{
  "name": "statepro-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "STUDIO_USE_EDITOR_CORE_SRC=true pnpm --filter studio-app dev",
    "dev:dist": "STUDIO_USE_EDITOR_CORE_SRC=false pnpm --filter @rendis/statepro-studio-react build && pnpm --parallel --stream --filter @rendis/statepro-studio-react --filter studio-app run dev",
    "dev:doctor": "node ./scripts/dev-doctor.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "nanoid": "^3.3.18",
      "ws": "^8.21.3",
      "fast-uri": "^3.1.8",
      "postcss": "^8.5.26",
      "vite": "^6.4.3",
      "vitest": "^3.2.6",
      "qs": "^6.16.0",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@^5.0.0": "^5.0.12",
      "postcss-selector-parser@^6.0.0": "^6.1.3",
      "@babel/core": "^7.29.6",
      "esbuild@^0.27.0": "0.28.2"
    }
  }
}
